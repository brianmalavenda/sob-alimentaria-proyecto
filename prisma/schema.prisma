generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Ingrediente {
  id        String   @id @default(cuid())
  nombre    String
  descripcion String?
  precio    Float
  stock     Float    @default(0)
  unidad    String   @default("kg")
  categoria String   @default("General")
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  platosIngredientes  PlatoIngrediente[]
  bolsonesIngredientes BolsonIngrediente[]
  historialPrecios    HistorialPrecio[]
}

// Auditoría de precios: cada cambio de precio de un ingrediente queda
// registrado como un tramo con vigencia "desde" una fecha determinada.
// El precio vigente de un tramo se mantiene hasta que se registre el
// siguiente cambio (o hasta hoy, si es el tramo más reciente).
model HistorialPrecio {
  id             String   @id @default(cuid())
  ingredienteId  String
  precio         Float
  precioAnterior Float?
  vigenciaDesde  DateTime @default(now())
  usuario        String?
  motivo         String?
  createdAt      DateTime @default(now())

  ingrediente Ingrediente @relation(fields: [ingredienteId], references: [id], onDelete: Cascade)

  @@index([ingredienteId, vigenciaDesde])
}

model Plato {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String?
  precio      Float
  stock       Int      @default(0)
  activo      Boolean  @default(true)
  imagen      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ingredientes PlatoIngrediente[]
  pedidos      Pedido[]
}

model PlatoIngrediente {
  platoId       String
  ingredienteId String
  cantidad      Float

  plato       Plato       @relation(fields: [platoId], references: [id], onDelete: Cascade)
  ingrediente Ingrediente @relation(fields: [ingredienteId], references: [id], onDelete: Cascade)

  @@id([platoId, ingredienteId])
}

model Bolson {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String?
  tipo        String   @default("GENERAL")
  precio      Float
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ingredientes BolsonIngrediente[]
  pedidos      Pedido[]
}

model BolsonIngrediente {
  bolsonId      String
  ingredienteId String
  cantidad      Float

  bolson      Bolson      @relation(fields: [bolsonId], references: [id], onDelete: Cascade)
  ingrediente Ingrediente @relation(fields: [ingredienteId], references: [id], onDelete: Cascade)

  @@id([bolsonId, ingredienteId])
}

model Consumidor {
  id        String   @id @default(cuid())
  nombre    String
  telefono  String?
  email     String?
  direccion String?
  notas     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pedidos Pedido[]
}

model Pedido {
  id         String   @id @default(cuid())
  consumidorId  String
  tipo       String   @default("PLATO")
  platoId    String?
  bolsonId   String?
  cantidad   Int      @default(1)
  estado     String   @default("PENDIENTE")
  notas      String?
  total      Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  consumidor Consumidor @relation(fields: [consumidorId], references: [id], onDelete: Cascade)
  plato   Plato?  @relation(fields: [platoId], references: [id], onDelete: SetNull)
  bolson  Bolson? @relation(fields: [bolsonId], references: [id], onDelete: SetNull)
}